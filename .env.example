# ==============================================================================
# SocialShield / DeepVerify - Environment Configuration Template
# Copy this file to '.env' and provide your credentials before starting the app.
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Secret key for signing and verifying JWT authorization tokens
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# MongoDB Atlas Cloud Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/socialshield?retryWrites=true&w=majority
# (Leave empty or commented out to use local SQLite database fallback)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/socialshield?retryWrites=true&w=majority

# Execution Environment: development | testing | production
FLASK_ENV=production

# SMTP Mail Delivery Configuration (Optional - for sending OTP password resets & security alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM=your_email@gmail.com

